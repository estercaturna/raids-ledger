{
  "name": "raids-ledger",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/t/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raids-ledger",
      "database_id": "743a368f-3fe3-4c5a-8385-4bc3618dd019",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RESET_HOUR_UTC": "10",
    "WEEK_ROTATION_TOKEN_HASH": "5a98edf7d8a41b2315b2799d5075e91d676fb05080514117a89cec22507bf11f",
    "ROTATION_ANCHOR_WEEK": "2026-11-11T10:00:00.000Z",
    "ROTATION_ANCHOR_NAME": "Phirk",
    "ROTATION_OTHER_NAME": "Skyfire"
  }
}